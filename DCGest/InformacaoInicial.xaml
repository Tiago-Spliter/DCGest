<Page x:Class="DCGest.InformacaoInicial"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DCGest"
      mc:Ignorable="d" 
      d:DesignHeight="745" d:DesignWidth="1290"
      Title="Informacao" Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <Border Background="White" CornerRadius="20" Padding="50" BorderBrush="#E0E6ED" BorderThickness="1" MaxWidth="1000">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <Image Source="/Logo/DCGest.png" Width="100" Height="100" Stretch="Uniform"/>
                        <TextBlock Text="DCGest" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="56" FontWeight="Bold" Foreground="#1A2E52"/>
                    </StackPanel>

                    <TextBlock Text="Gestor para Diretores de Curso" FontSize="26" FontWeight="SemiBold" Foreground="#243A6E" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="O DCGest é uma aplicação de gestão escolar que ajuda diretores de curso na organização e acompanhamento dos alunos. Concentra a informação importante num único local, tornando a gestão mais simples e eficiente." 
                               FontSize="18" Foreground="#5A6478" TextAlignment="Center" TextWrapping="Wrap" LineHeight="28"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                <Border Background="White" CornerRadius="12" Padding="20,12" Margin="10" BorderBrush="#E0E6ED" BorderThickness="1">
                    <TextBlock Text="📊 Organização" Foreground="#293472" FontWeight="SemiBold" FontSize="16"/>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20,12" Margin="10" BorderBrush="#E0E6ED" BorderThickness="1">
                    <TextBlock Text="⚡ Rapidez" Foreground="#293472" FontWeight="SemiBold" FontSize="16"/>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="20,12" Margin="10" BorderBrush="#E0E6ED" BorderThickness="1">
                    <TextBlock Text="🛡️ Segurança" Foreground="#293472" FontWeight="SemiBold" FontSize="16"/>
                </Border>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
