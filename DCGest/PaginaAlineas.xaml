<UserControl x:Class="DCGest.PaginaAlineas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuração de Alíneas" FontSize="32" FontWeight="Bold"
                   Foreground="#1A2E52" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" FontSize="14" Foreground="#5A6478" Margin="0,0,0,20"
                   Text="Atribua a letra de alínea (ex: a), f)) a cada regra. As regras são fixas; só a designação da alínea é editável."/>

        <DataGrid Grid.Row="2" Name="dg_alineas" AutoGenerateColumns="False" CanUserAddRows="False"
                  RowHeight="38" FontSize="13" Background="White" BorderBrush="#E0E6ED" BorderThickness="1"
                  HorizontalGridLinesBrush="#F3F5F9" VerticalGridLinesBrush="#F3F5F9"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Alínea" Binding="{Binding AlineaLetra, UpdateSourceTrigger=PropertyChanged}" Width="120">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="MaxLength" Value="2"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Regra" Binding="{Binding Regra}" IsReadOnly="True" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="8,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="AcceptsReturn" Value="False"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Guardar" Width="140" Height="42" FontSize="15" FontWeight="Bold"
                Foreground="White" Background="#293472" BorderThickness="0" Cursor="Hand"
                HorizontalAlignment="Left" Margin="0,20,0,0"
                Click="Btn_Guardar_Click"/>
    </Grid>
</UserControl>
