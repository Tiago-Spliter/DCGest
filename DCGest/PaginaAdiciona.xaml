<Page x:Class="DCGest.PaginaAdiciona"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="745" d:DesignWidth="1290"
      Title="Novo Registo" Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <TextBlock Text="Criação de Novos Registos" FontSize="32" FontWeight="Bold" Foreground="#1A2E52" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Border Width="600" Background="White" CornerRadius="20" Padding="40" BorderBrush="#E0E6ED" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tipo de Entidade" FontWeight="SemiBold" Foreground="#5A6478" Margin="0,0,0,8"/>
                    <ComboBox Name="cmb_tipo" Height="35" Margin="0,0,0,30" VerticalContentAlignment="Center" SelectionChanged="Cmb_Tipo_Seleciona">
                        <ComboBoxItem Content="Aluno" IsSelected="True"/>
                        <ComboBoxItem Content="Orientador"/>
                    </ComboBox>

                    <!-- Painel Aluno -->
                    <StackPanel Name="painelAluno" Visibility="Visible">
                        <TextBlock Text="Código do Aluno" Foreground="#5A6478" Margin="0,0,0,5"/>
                        <TextBox Name="txtCodAluno" Height="32" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Nome Completo" Foreground="#5A6478" Margin="0,0,0,5"/>
                        <TextBox Name="txtNomeAluno" Height="32" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Turma" Foreground="#5A6478" Margin="0,0,0,5"/>
                                <ComboBox Name="cmb_Turma" Height="32" VerticalContentAlignment="Center" DisplayMemberPath="Nome" SelectedValuePath="Cod_Turma"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Curso" Foreground="#5A6478" Margin="0,0,0,5"/>
                                <ComboBox Name="cmb_Curso" Height="32" VerticalContentAlignment="Center" DisplayMemberPath="Nome_Curso" SelectedValuePath="Cod_Curso"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Orientador" Foreground="#5A6478" Margin="0,0,0,5"/>
                        <ComboBox Name="cmb_Orientador" Height="32" Margin="0,0,0,15" VerticalContentAlignment="Center" DisplayMemberPath="Nome_Orientador" SelectedValuePath="Cod_Orientador"/>

                        <TextBlock Text="Ano Letivo" Foreground="#5A6478" Margin="0,0,0,5"/>
                        <ComboBox Name="cmb_Ano" Height="32" Margin="0,0,0,30" VerticalContentAlignment="Center" DisplayMemberPath="Intervalo" SelectedValuePath="Cod_Letivo"/>
                    </StackPanel>

                    <!-- Painel Orientador -->
                    <StackPanel Name="painelOrientador" Visibility="Collapsed">
                        <TextBlock Text="Nome do Orientador" Foreground="#5A6478" Margin="0,0,0,5"/>
                        <TextBox Name="txtNomeOri" Height="35" Margin="0,0,0,40" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Guardar Registo" Width="200" Height="45" Background="#293472" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="Btn_Click_Guardar" Margin="0,0,15,0"/>
                        <Button Content="Limpar" Width="120" Height="45" Background="#F3F5F9" Cursor="Hand" Click="Btn_Click_Limpar"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
