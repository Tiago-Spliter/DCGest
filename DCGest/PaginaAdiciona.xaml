<Page x:Class="DCGest.PaginaAdiciona"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="745" d:DesignWidth="1550"
      Title="Novo Registo" Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid>
        
        <TextBlock Text="Novo Registo" FontSize="36" FontWeight="Bold" Foreground="#1E2A44" HorizontalAlignment="Center" Margin="0,20,0,0"/>

        <!-- Formulário -->
        <Border Width="600" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#D0D6E2" BorderThickness="1" Margin="0,50,0,0">

            <StackPanel Margin="20">

                <TextBlock Text="Tipo de Entidade" FontWeight="SemiBold" FontSize="14"/>
                <ComboBox Name="cmb_tipo" Height="32" Margin="0,6,0,20" VerticalContentAlignment="Center" SelectionChanged="Cmb_Tipo_Seleciona">
                    <ComboBoxItem Content="Aluno" IsSelected="True"/>
                    <ComboBoxItem Content="Orientador"/>
                </ComboBox>

                <StackPanel Name="painelAluno" Visibility="Visible">

                    <TextBlock Text="Código do Aluno" FontSize="14"/>
                    <TextBox Name="txtCodAluno" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Nome do Aluno" FontSize="14"/>
                    <TextBox Name="txtNomeAluno" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Turma" FontSize="14"/>
                    <ComboBox Name="cmb_Turma" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Curso" FontSize="14"/>
                    <ComboBox Name="cmb_Curso" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Orientador" FontSize="14"/>
                    <ComboBox Name="cmb_Orientador" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Ano Letivo" FontSize="14"/>
                    <ComboBox Name="cmb_Ano" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>

                </StackPanel>

                <StackPanel Name="painelOrientador" Visibility="Collapsed">
                    <TextBlock Text="Nome do Orientador" FontSize="14"/>
                    <TextBox Name="txtNomeOri" Height="35" Margin="0,4,0,12" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Guardar" Width="160" Height="42" Background="#293472" Foreground="White" Click="Btn_Click_Guardar" Margin="0,0,10,0"/>
                    <Button Content="Limpar" Width="140" Height="42" Click="Btn_Click_Limpar"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
