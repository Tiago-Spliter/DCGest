<Window x:Class="DCGest.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:DCGest" 
        mc:Ignorable="d" 
        Title="Inicio" Height="875" Width="1550" WindowState="Maximized" Background="#F3F5F9" FontFamily="Segoe UI">
    
    <Grid>

        <!-- Menu -->
        <StackPanel Height="105" VerticalAlignment="Top" Background="#293472" Orientation="Horizontal">
            
            <Canvas Name="Logo" Background="#EFE6D8" Height="75" Width="75" Margin="30,10,15,10"/>
            <Line Stroke="#1B2E57" StrokeThickness="2" Y2="60" Margin="10,20"/>
            <Button Name="btN_Inicial" Content="Página inicial" Height="90" Width="170" FontSize="18" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Padding="14,6" Cursor="Hand" VerticalAlignment="Center" Click="Btn_Click_PaginaInicial"/>
            <Button Name="btn_Lista" Content="Lista de alunos" Height="90" Width="170" FontSize="18" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Padding="14,6" Cursor="Hand" VerticalAlignment="Center" Click="Btn_Click_PaginaListaAlunos"/>
            <Button Name="btn_Adiciona" Content="Novo registo" Height="90" Width="170" FontSize="18" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Padding="14,6" Cursor="Hand" VerticalAlignment="Center" Click="Btn_Click_PaginaAdiciona"/>
            
        </StackPanel>

        <Frame Name="frm" Height="745" Width="1550" NavigationUIVisibility="Hidden" Margin="0,105,0,0"/>
    </Grid>
</Window>
