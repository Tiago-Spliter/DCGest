<Window x:Class="DCGest.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:DCGest" 
        mc:Ignorable="d" 
        Title="Inicio" Height="875" Width="1550" WindowState="Maximized" Background="#F3F5F9" FontFamily="Segoe UI">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border Grid.Column="0" Background="#293472">
            <StackPanel>
                <!-- Cabeçalho do Menu -->
                <StackPanel Margin="0,45,0,40">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="12" Padding="8" Width="55" Height="55">
                            <Image Source="/Logo/DCGest.png" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="DCGest" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="GESTÃO ACADÉMICA" FontSize="10" FontWeight="SemiBold" Foreground="#8A92B2"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Rectangle Height="1" Fill="#3E4989" Margin="30,35,30,0"/>
                </StackPanel>

                <!-- Navegação -->
                <Button Name="btN_Inicial" Content="Página inicial" Height="60" FontSize="17" FontWeight="SemiBold" Foreground="White" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="30,0" Cursor="Hand" Click="Btn_Click_PaginaInicial"/>
                <Button Name="btn_Lista" Content="Lista de alunos" Height="60" FontSize="17" FontWeight="SemiBold" Foreground="#D0D6E2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="30,0" Cursor="Hand" Click="Btn_Click_PaginaListaAlunos"/>
                <Button Name="btn_Adiciona" Content="Novo registo" Height="60" FontSize="17" FontWeight="SemiBold" Foreground="#D0D6E2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="30,0" Cursor="Hand" Click="Btn_Click_PaginaAdiciona"/>
            </StackPanel>
        </Border>

        <!-- Área Principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <TextBlock Text="Bem-vindo ao Sistema de Gestão" VerticalAlignment="Center" FontSize="18" Foreground="#5A6478" FontWeight="Medium"/>
                </Grid>
            </Border>

            <!-- Frame -->
            <Frame Name="frm" Grid.Row="1" NavigationUIVisibility="Hidden" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
