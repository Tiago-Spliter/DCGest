<Window x:Class="DCGest.PaginaNotas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DCGest"
        
        mc:Ignorable="d"
        Title="Notas" Height="875" Width="1550" WindowState="Maximized">
    <Grid>

        <StackPanel Height="105" VerticalAlignment="Top" Background="#293472" Orientation="Horizontal">
            <Canvas Name="Logo" Background="#EFE6D8" Height="75" Width="75" Margin="30,10,15,10"/>
            <Line Stroke="#1B2E57" StrokeThickness="2" Y2="60" Margin="10,20"/>
            <TextBlock Text="Aluno : " FontSize="35" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Name="txtNomeAluno" Width="1000" FontSize="28" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Margin="0,140,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="1400">

            <TextBlock Text="Detalhes do Aluno" FontSize="38" FontWeight="Bold" Foreground="#1E2A44" Margin="0,0,0,0" HorizontalAlignment="Center"/>

            <!-- Escolhas -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                <Button Name="btn_ano1" Content="1º Ano" Width="100" Height="40" FontSize="18" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Click="Btn_Click_Ano1"/>
                <Button Name="btn_ano2" Content="2º Ano" Width="100" Height="40" FontSize="18" FontWeight="SemiBold" Foreground="#293472" Background="#EFE6D8" BorderThickness="0" Margin="5,0,0,0" Click="Btn_Click_Ano2"/>
                <Button Name="btn_ano3" Content="3º Ano" Width="100" Height="40" FontSize="18" FontWeight="SemiBold" Foreground="#293472" Background="#EFE6D8" BorderThickness="0" Margin="5,0,0,0" Click="Btn_Click_Ano3"/>
            </StackPanel>

            <DataGrid Name="dg_alunos" MaxHeight="500" VerticalScrollBarVisibility="Auto" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Margin="0,10,0,0" RowBackground="White" AlternatingRowBackground="#F2F2F2" GridLinesVisibility="None" BorderBrush="#293472" BorderThickness="2">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Módulo" Binding="{Binding Modulo}" IsReadOnly="True" Width="*"/>

                    <DataGridTextColumn Header="Disciplina" Binding="{Binding Disciplina}" IsReadOnly="True" Width="*"/>

                    <DataGridTextColumn Header="Nota"
                            Binding="{Binding Valor, UpdateSourceTrigger=PropertyChanged}"
                            Width="100"/>

                    <DataGridTextColumn Header="Data"
                            Binding="{Binding Data_Efetua, StringFormat=d}"
                            IsReadOnly="True"
                            Width="150"/>

                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Height="50" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Editar" Width="150" FontSize="20" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Padding="12,6" Margin="20,0" Click="Btn_Click_Editar"/>
                <Button Content="Voltar" Width="150" FontSize="20" FontWeight="SemiBold" Foreground="#293472" Background="White" BorderBrush="#293472" BorderThickness="1" Padding="12,6" Margin="20,0" Click="Btn_Click_Voltar"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>