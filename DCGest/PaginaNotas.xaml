<Window x:Class="DCGest.PaginaNotas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DCGest"
        mc:Ignorable="d"
        Title="Notas" Height="875" Width="1550" WindowState="Maximized" Background="#F3F5F9" FontFamily="Segoe UI">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#293472">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Logo/DCGest.png" Width="60" Height="60" Margin="30,0,20,0" Stretch="Uniform"/>
                <TextBlock Text="Notas do Aluno:" FontSize="24" FontWeight="SemiBold" Foreground="#D0D6E2" VerticalAlignment="Center"/>
                <TextBlock Name="txtNomeAluno" Text="Nome do Aluno" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Registo de Avaliações" FontSize="32" FontWeight="Bold" Foreground="#1A2E52" Margin="0,0,0,20"/>

            <!-- Filtro de Anos -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Name="btn_ano1" Content="1º Ano" Width="120" Height="40" FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Cursor="Hand" Click="Btn_Click_Ano1"/>
                <Button Name="btn_ano2" Content="2º Ano" Width="120" Height="40" FontSize="16" FontWeight="SemiBold" Foreground="#293472" Background="White" BorderThickness="1" BorderBrush="#293472" Margin="10,0,0,0" Cursor="Hand" Click="Btn_Click_Ano2"/>
                <Button Name="btn_ano3" Content="3º Ano" Width="120" Height="40" FontSize="16" FontWeight="SemiBold" Foreground="#293472" Background="White" BorderThickness="1" BorderBrush="#293472" Margin="10,0,0,0" Cursor="Hand" Click="Btn_Click_Ano3"/>
            </StackPanel>

            <!-- Área de Tabelas Lado a Lado -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="650"/>
                </Grid.ColumnDefinitions>

                <!-- Esquerda: DataGrid Notas (Módulos) -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Detalhe por Módulo" FontSize="18" FontWeight="Bold" Foreground="#5A6478" Margin="0,0,0,10"/>
                    <DataGrid Name="dg_alunos" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="35" FontSize="13" Background="White" BorderBrush="#E0E6ED" BorderThickness="1" HorizontalGridLinesBrush="#F3F5F9" VerticalGridLinesBrush="#F3F5F9" Height="400">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Disciplina" Binding="{Binding NomeDisciplina}" IsReadOnly="True" Width="250"/>
                            <DataGridTextColumn Header="Módulo" Binding="{Binding NomeModulo}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Nota" Binding="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data_Efetua, StringFormat=dd/MM/yyyy}" IsReadOnly="True" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Direita: DataGrid Médias (Resumo) -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="Resumo por Disciplina" FontSize="18" FontWeight="Bold" Foreground="#5A6478" Margin="0,0,0,10"/>
                    <DataGrid Name="dg_medias" IsReadOnly="True" AutoGenerateColumns="False" RowHeight="35" FontSize="13" Background="White" BorderBrush="#E0E6ED" BorderThickness="1" HorizontalGridLinesBrush="#F3F5F9" VerticalGridLinesBrush="#F3F5F9" Height="400">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TipoDisciplina}" Value="Técnica">
                                        <Setter Property="Background" Value="#D7E1FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TipoDisciplina}" Value="Científica">
                                        <Setter Property="Background" Value="#D7FFD7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TipoDisciplina}" Value="Sociocultural">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Disciplina" Binding="{Binding NomeDisciplina}" Width="*"/>
                            <DataGridTextColumn Header="Média" Binding="{Binding Media, StringFormat={}{0:N2}}" Width="80"/>
                            <DataGridTextColumn Header="Mód NR" Binding="{Binding ModulosRealizados}" Width="70"/>
                            <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <!-- Baixo: Resultados Finais -->
            <Border Grid.Row="3" Background="White" CornerRadius="15" Padding="20" BorderBrush="#E0E6ED" BorderThickness="1" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Médias -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="Geral" FontSize="12" Foreground="#5A6478" HorizontalAlignment="Center"/>
                            <TextBox Name="txt_mediaGeral" IsReadOnly="True" Text="---" Width="80" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" Background="#F8FAFC"/>
                        </StackPanel>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="Científica" FontSize="12" Foreground="#5A6478" HorizontalAlignment="Center"/>
                            <TextBox Name="txt_mediaCientifica" IsReadOnly="True" Text="---" Width="80" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" Background="#F8FAFC"/>
                        </StackPanel>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="Técnica" FontSize="12" Foreground="#5A6478" HorizontalAlignment="Center"/>
                            <TextBox Name="txt_mediaTecnica" IsReadOnly="True" Text="---" Width="80" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" Background="#F8FAFC"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="#E0E6ED" Margin="30,0"/>

                    <!-- FCT e PAP -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="15,0">
                            <TextBlock Text="Nota FCT" FontSize="12" Foreground="#5A6478" HorizontalAlignment="Center"/>
                            <TextBox Name="txt_notaFCT" Text="0" Width="100" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="15,0">
                            <TextBlock Text="Nota PAP" FontSize="12" Foreground="#5A6478" HorizontalAlignment="Center"/>
                            <TextBox Name="txt_notaPAP" Text="0" Width="100" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Width="1" Fill="#E0E6ED" Margin="30,0"/>

                    <!-- Média Final -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="MÉDIA FINAL:" VerticalAlignment="Center" Foreground="#1A2E52" FontWeight="Black" FontSize="16" Margin="0,0,15,0"/>
                        <Border Background="#293472" CornerRadius="8" Padding="15,5">
                            <TextBlock Name="lbl_mediaFinal" Text="---" Foreground="White" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Botões de Ação -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button Content="Guardar Alterações" Width="220" Height="45" FontSize="16" FontWeight="Bold" Foreground="White" Background="#293472" BorderThickness="0" Cursor="Hand" Click="Btn_Click_Editar" Margin="0,0,15,0"/>
                <Button Content="Fechar Janela" Width="150" Height="45" FontSize="16" FontWeight="SemiBold" Foreground="#5A6478" Background="#F3F5F9" BorderThickness="0" Cursor="Hand" Click="Btn_Click_Voltar"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
