<Window x:Class="DCGest.JanelaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCGest - Login" Height="450" Width="400" WindowStartupLocation="CenterScreen" 
        Background="#F3F5F9" FontFamily="Segoe UI" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True">
    
    <Border Background="White" CornerRadius="20" Margin="20" BorderBrush="#E0E6ED" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        
        <StackPanel Margin="30">
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                <Border Width="60" Height="60" Background="LightSteelBlue" CornerRadius="12" Padding="8">
                    <Image Source="/Logo/DCGest.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="DCGest" FontSize="28" FontWeight="Bold" Foreground="#1A2E52" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <TextBlock Text="Utilizador" Foreground="#5A6478" Margin="0,0,0,5"/>
            <TextBox Name="txt_user" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Palavra-Passe" Foreground="#5A6478" Margin="0,0,0,5"/>
            <PasswordBox Name="txt_pass" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,30"/>

            <Button Content="Entrar" Height="45" Background="#293472" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="Btn_Click_Entrar" IsDefault="True"/>
            <Button Content="Sair" Height="35" Margin="0,10,0,0" Background="Transparent" Foreground="#5A6478" BorderThickness="0" Cursor="Hand" Click="Btn_Click_Sair"/>
        </StackPanel>
    </Border>
</Window>
