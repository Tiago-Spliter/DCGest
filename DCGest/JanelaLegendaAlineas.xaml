<Window x:Class="DCGest.JanelaLegendaAlineas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legenda de Alíneas" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Legenda de Alíneas" FontSize="20" FontWeight="Bold"
                   Foreground="#1A2E52" Margin="0,0,0,16"/>

        <DataGrid Grid.Row="1" Name="dg_alineas" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" RowHeight="32" FontSize="13"
                  Background="White" BorderBrush="#E0E6ED" BorderThickness="1"
                  HorizontalGridLinesBrush="#F3F5F9" VerticalGridLinesBrush="#F3F5F9">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Alínea" Binding="{Binding AlineaLetra}" Width="70"/>
                <DataGridTextColumn Header="Regra"  Binding="{Binding Regra}"       Width="130"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="4,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Fechar" Width="100" Height="36" FontSize="14"
                FontWeight="SemiBold" Foreground="White" Background="#293472"
                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                Margin="0,16,0,0" Click="Btn_Fechar_Click"/>
    </Grid>
</Window>
