<Page x:Class="DCGest.PaginaListaAlunos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DCGest"
      mc:Ignorable="d" 
      d:DesignHeight="745" d:DesignWidth="1550"
      Title="Lista de Alunos" Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid>

        <!-- ================= CONTEÚDO BASE ================= -->
        <Grid>
            <Button Name="Btn_AbrirOverlay" Content="Outro Curso 🔍" Width="140" Height="36" FontSize="14" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,40,0" Click="Btn_Click_AbrirSeleciona"/>
            
            <Border HorizontalAlignment="Left" Width="240" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0" Padding="10">

                <StackPanel>

                    <TextBlock Text="Filtrar alunos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <TextBlock Text="Código do Aluno"/>
                    <TextBox Name="txt_codigo" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                    <TextBlock Text="Nome"/>
                    <TextBox Name="txt_nome" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                    <TextBlock Text="Turma"/>
                    <ComboBox Name="cmb_turma" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                    <TextBlock Text="Orientador"/>
                    <ComboBox Name="cmb_orientador" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                    <Button Content="Aplicar filtros" Height="32" Margin="0,10,0,0" Click="Btn_Click_Filtrar"/>
                    <Button Content="Limpar" Height="32" Margin="0,6,0,0" Background="#E0E0E0" Click="Btn_Click_LimparFiltro"/>

                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="1100" Margin="0,20,140,0">

                <TextBlock Text="Lista de Alunos" FontSize="38" FontWeight="Bold" Foreground="#1E2A44" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                
                <DataGrid Name="dg_alunos" IsReadOnly="True" Height="520" FontSize="16" BorderBrush="#D0D6E2" BorderThickness="1" Background="White" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Cod_Aluno}" Width="80"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome_Aluno}" Width="*"/>
                        <DataGridTextColumn Header="Turma" Binding="{Binding Turma}" Width="100"/>
                        <DataGridTextColumn Header="Curso" Binding="{Binding Nome_Curso}" Width="250"/>
                        <DataGridTextColumn Header="Ano Letivo" Binding="{Binding Ano_Letivo}" Width="120"/>
                        <DataGridTextColumn Header="Estágio" Binding="{Binding Estado_Estagio}" Width="150"/>
                        <DataGridTextColumn Header="Orientador" Binding="{Binding Nome_Orientador}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" Width="400" VerticalAlignment="Center">

                    <Button Content="Selecionar Aluno" Width="250" FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Center" Click="Btn_Click_Seleciona"/>

                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- ================= OVERLAY ================= -->
        <Border Name="Overlay" Background="#99000090" Visibility="Visible">

            <Grid Width="800" Height="500" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Margin="40">

                    <TextBlock Text="Cursos disponíveis" FontSize="32" FontWeight="Bold" Foreground="#1E2A44" Margin="0,0,0,20"/>
                    <TextBlock Text="Escolha o Curso / Ano letivo desejados: " FontSize="18" Margin="0,0,0,20"/>

                    <!-- Ano Letivo -->
                    <TextBlock Text="Ano Letivo" Width="250" FontSize="20" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                    <ComboBox Name="cmb_anoletivo" Height="35" Width="250" FontSize="15" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,4,0,22"/>


                    <!-- Curso -->
                    <TextBlock Text="Curso" Width="250" FontSize="20" HorizontalAlignment="Left"/>
                    <ComboBox Name="cmb_curso" Height="35" Width="250" FontSize="15" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="0,4,0,12"/>

                    <Button Content="Continuar" Height="40" Width="300" HorizontalAlignment="Center" Margin="0,50,0,0" Click="Btn_Click_Continuar"/>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Page>
