<Page x:Class="DCGest.PaginaListaAlunos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DCGest"
      mc:Ignorable="d" 
      d:DesignHeight="745" d:DesignWidth="1290"
      Title="Lista de Alunos" Background="#F3F5F9" FontFamily="Segoe UI">

    <Grid>
        <!-- CONTEÚDO BASE -->
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Filtros -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="20" BorderBrush="#E0E6ED" BorderThickness="1" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="Filtrar alunos" FontSize="20" FontWeight="Bold" Foreground="#293472" Margin="0,0,0,20"/>

                    <TextBlock Text="Código do Aluno" Foreground="#5A6478" Margin="0,0,0,5"/>
                    <TextBox Name="txt_codigo" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Nome" Foreground="#5A6478" Margin="0,0,0,5"/>
                    <TextBox Name="txt_nome" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Turma" Foreground="#5A6478" Margin="0,0,0,5"/>
                    <ComboBox Name="cmb_turma" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15" DisplayMemberPath="Nome" SelectedValuePath="Cod_Turma"/>

                    <TextBlock Text="Orientador" Foreground="#5A6478" Margin="0,0,0,5"/>
                    <ComboBox Name="cmb_orientador" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,20" DisplayMemberPath="Nome_Orientador" SelectedValuePath="Cod_Orientador"/>

                    <Button Content="Aplicar Filtros" Height="38" Background="#293472" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Click="Btn_Click_Filtrar"/>
                    <Button Content="Limpar" Height="38" Margin="0,8,0,0" Background="#F3F5F9" Cursor="Hand" Click="Btn_Click_LimparFiltro"/>
                </StackPanel>
            </Border>

            <!-- Grelha Central -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Bar da Grelha corrigida -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Listagem Escolar" FontSize="28" FontWeight="Bold" Foreground="#1A2E52" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Name="Btn_AbrirOverlay" Content="Mudar de Curso 🔍" Width="160" Height="36" FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand" Click="Btn_Click_AbrirSeleciona"/>
                </Grid>

                <DataGrid Name="dg_alunos" Grid.Row="1" IsReadOnly="True" FontSize="15" BorderBrush="#E0E6ED" BorderThickness="1" Background="White" AutoGenerateColumns="False" HorizontalGridLinesBrush="#F3F5F9" VerticalGridLinesBrush="#F3F5F9" RowHeight="40">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cod" Binding="{Binding Cod_Aluno}" Width="60"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome_Aluno}" Width="*"/>
                        <DataGridTextColumn Header="Turma" Binding="{Binding Nome_Turma}" Width="80"/>
                        <DataGridTextColumn Header="Curso" Binding="{Binding Nome_Curso}" Width="200"/>
                        <DataGridTextColumn Header="Ano" Binding="{Binding Intervalo_Letivo}" Width="100"/>
                        <DataGridTextColumn Header="Estágio" Binding="{Binding Estado_Estagio}" Width="120"/>
                        <DataGridTextColumn Header="Orientador" Binding="{Binding Nome_Orientador}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Ver Notas" Height="45" Width="200" FontSize="16" FontWeight="SemiBold" Foreground="White" Background="#293472" BorderThickness="0" Cursor="Hand" Click="Btn_Click_Seleciona" Margin="0,0,10,0"/>
                    <Button Content="Gerar PDF 📄" Height="45" Width="200" FontSize="16" FontWeight="SemiBold" Foreground="#293472" Background="White" BorderBrush="#293472" BorderThickness="1" Cursor="Hand" Click="Btn_Click_GerarPDF"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- OVERLAY -->
        <Border Name="Overlay" Background="#99000000" Visibility="Visible">
            <Border Background="White" Width="500" Height="450" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
                <StackPanel>
                    <TextBlock Text="Escolha o Curso que deseja" FontSize="28" FontWeight="Bold" Foreground="#1A2E52" Margin="0,0,0,30"/>
                    
                    <TextBlock Text="Ano Letivo" Foreground="#5A6478" Margin="0,0,0,5"/>
                    <ComboBox Name="cmb_anoletivo" Height="35" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,20" DisplayMemberPath="Intervalo" SelectedValuePath="Cod_Letivo"/>

                    <TextBlock Text="Curso" Foreground="#5A6478" Margin="0,0,0,5"/>
                    <ComboBox Name="cmb_curso" Height="35" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,40" DisplayMemberPath="Nome_Curso" SelectedValuePath="Cod_Curso"/>

                    <Button Content="Carregar Dados" Height="45" FontSize="16" FontWeight="Bold" Foreground="White" Background="#293472" BorderThickness="0" Cursor="Hand" Click="Btn_Click_Continuar"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
